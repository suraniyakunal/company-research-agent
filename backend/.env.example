GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here
# PostgreSQL connection string — add a PostgreSQL plugin on Railway to get this auto-injected.
# Leave unset for local dev without a database (analytics tracking is disabled but app still works).
DATABASE_URL=postgresql://user:password@host:5432/dbname
